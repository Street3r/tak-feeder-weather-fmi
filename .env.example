# ---------------------------------------------------------------- TAK server
COT_URL=ssl://takserver:8089
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=1
#PYTAK_TLS_CLIENT_CAFILE=/data/ca.pem
#TAK_PROTO=0

# ---------------------------------------------------------------- FMI
# Area: west,south,east,north
#FMI_BBOX=18,59,33,71
#WEATHER_PARAMETERS=t2m,ws_10min,wg_10min,wd_10min,rh,p_sea,vis,snow_aws,wawa
# How far back to look for each station's latest values (min)
#HISTORY_MINUTES=60
#TIMEZONE=Europe/Helsinki

# ---------------------------------------------------------------- Weather alerts
# Normal stations are plain markers. A station whose values reach a level
# gets a built-in ATAK icon tinted yellow/orange/red, a callsign word (WIND,
# FROST, ICE, HEAT, FOG), an ALERT line and #alert tags.
# Lowest level shown: yellow, orange or red
#ALERT_MIN_LEVEL=orange
# Which alerts are on
#ALERTS=wind,frost,freezing,heat,visibility
# Thresholds "yellow,orange,red". Defaults are FMI's warning criteria.
# Frost (°C, temperature or wind chill) by region; region borders by latitude
#FROST_SOUTH=-20,-30,-35
#FROST_CENTRAL=-25,-35,-40
#FROST_NORTH=-30,-40,-45
#FROST_CENTRAL_LAT=62.5
#FROST_NORTH_LAT=65.5
# Heat (°C)
#HEAT=27,30,35
# Wind gusts (m/s): winter Nov-Apr, summer May-Oct; mean wind (m/s, sea criteria)
#WIND_GUSTS_WINTER=20,25,30
#WIND_GUSTS_SUMMER=15,20,25
#WIND_MEAN=14,21,33
# Visibility (m, at or below); not an FMI criterion
#VISIBILITY=1000,200,50
# Freezing drizzle / rain from present weather (wawa), always orange
#FREEZING=1

# ---------------------------------------------------------------- Radiation
# Weather stations (0 = off, e.g. for a second container that only sends
# radiation with RADIATION=1 to a group of its own)
#WEATHER=1
# STUK external dose rate stations (1 = on)
#RADIATION=0
# Dose rate (µSv/h) that marks a station ALERT
#RADIATION_ALERT_LEVEL=0.4
# Alert look. Normal stations keep the plain marker; above the alert level
# the marker gets this ATAK iconset icon (empty = no icon change), optional
# ARGB colour (e.g. -65536 red, tints white icons) and CoT type
# (e.g. b-l-c-n-r, the CoT radiation alarm type).
#RADIATION_ALERT_ICON=f8f7f666-8b28-4b57-9fbb-e48e61d33b79/Iron Sites/HAZMAT.png
#RADIATION_ALERT_COLOR=
#RADIATION_ALERT_TYPE=a-n-G

# ---------------------------------------------------------------- Output
# Seconds between send rounds; every round re-sends the latest data
#UPDATE_INTERVAL=60
# Seconds between FMI/STUK fetches (FMI updates every 10 min)
#FETCH_INTERVAL=300
#STALE_SECONDS=300
#SOURCE_LINE=Source: Finnish Meteorological Institute open data, CC BY 4.0
#DEBUG=0
