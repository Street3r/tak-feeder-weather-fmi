# ---------------------------------------------------------------- TAK server
COT_URL=ssl://takserver:8089
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=1
#PYTAK_TLS_CLIENT_CAFILE=/data/ca.pem
#TAK_PROTO=0

# ---------------------------------------------------------------- FMI
# Area: west,south,east,north
#FMI_BBOX=18,59,33,71
#WEATHER_PARAMETERS=t2m,ws_10min,wg_10min,wd_10min,rh,p_sea,vis,snow_aws
# How far back to look for each station's latest values (min)
#HISTORY_MINUTES=60
#TIMEZONE=Europe/Helsinki

# ---------------------------------------------------------------- Radiation
# STUK external dose rate stations (1 = on)
#RADIATION=0
# Dose rate (µSv/h) that marks a station ALERT
#RADIATION_ALERT_LEVEL=0.4

# ---------------------------------------------------------------- Output
#UPDATE_INTERVAL=300
#STALE_SECONDS=900
#SOURCE_LINE=Source: Finnish Meteorological Institute open data, CC BY 4.0
#DEBUG=0
